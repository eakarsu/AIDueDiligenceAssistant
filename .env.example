NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=duediligence_db
DB_USER=due_diligence
DB_PASSWORD=replace-with-a-dedicated-password
JWT_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DOCUMENT_PROVIDER=disabled
OCR_PROVIDER=disabled
CORPORATE_DATA_PROVIDER=disabled
SANCTIONS_PROVIDER=disabled
MATTER_SYSTEM_PROVIDER=disabled
ENABLE_GENERATED_AI_SURFACES=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
